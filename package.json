{
  "name": "@aiaiaiai/website",
  "version": "0.0.0",
  "description": "The official website and interactive gateway to the aiaiaiai universe — independent worlds, shared curiosity.",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "format": "prettier --write src tests astro.config.mjs playwright.config.ts package.json tsconfig.json .github",
    "format:check": "prettier --check src tests astro.config.mjs playwright.config.ts package.json tsconfig.json .github",
    "test": "node --experimental-strip-types --test tests/motion.test.ts",
    "test:browser": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiaiaiai-org/aiaiaiai.org.git"
  },
  "license": "MPL-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/aiaiaiai-org/aiaiaiai.org/issues"
  },
  "homepage": "https://github.com/aiaiaiai-org/aiaiaiai.org#readme",
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "astro": "7.4.2",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  },
  "private": true
}
