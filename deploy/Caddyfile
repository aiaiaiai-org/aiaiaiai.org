{
  admin off
  auto_https off
}
:1927 {
  root * /srv/site
  encode zstd gzip
  respond /healthz "ok" 200
  # The beta hostname serves the verified development build at its root.
  @beta_root {
    host beta.aiaiaiai.org
    path /
  }
  rewrite @beta_root /beta/
  # The production hostname remains a temporary landing route until release.
  @production_root {
    not host beta.aiaiaiai.org
    path /
  }
  redir @production_root /beta/ 302
  header X-Content-Type-Options nosniff
  header Referrer-Policy strict-origin-when-cross-origin
  header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  file_server
}
