// The unfinished experience is excluded from the production document.
const preview = import.meta.env.DEV;
---

<!doctype html>
<html lang="en" class:list={{ preview }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {preview && <meta name="theme-color" content="#efefed" />}
    <meta name="description" content="aiaiaiai" />
    <title>aiaiaiai</title>
    <style is:global>
      :root {
        color-scheme: light;
      }
      html,
      body {
        margin: 0;
        width: 100%;
        min-height: 100%;
        background: #fff;
      }
      html.preview,
      html.preview body {
        background: #efefed;
      }
    </style>
  </head>
  <body>
    {preview && (
      <main id="awakening" aria-label="Star Awakening interaction preview">
        <div class="preview-note">aiaiaiai · interaction study</div>
        <div class="scene" aria-hidden="true"></div>
        <button
          class="star-target"
          aria-label="Awaken the star"
          aria-describedby="preview-status"
          disabled
        ></button>
        <span class="cue" aria-hidden="true">
          touch to begin
        </span>
        <p id="preview-status" role="status">
          Interaction preview. No model is connected or downloaded.
        </p>
        <button class="reset" hidden>
          Reset interaction
        </button>
        <noscript>This 3D interaction requires JavaScript.</noscript>
      </main>
    )}
    <script>
      // Dynamic import prevents scene and fonts from loading in the blank release.
      if (import.meta.env.DEV) {
        import('../star-awakening/mount')
          .then(({ mount }) => {
            const root = document.querySelector<HTMLElement>('#awakening');
            if (root) mount(root);
          })
          .catch((error: unknown) => {
            console.error('Star Awakening could not start', error);
            const status = document.querySelector('#preview-status');
            if (status)
              status.textContent =
                'The 3D preview could not start. Reload to try again.';
          });
      }
    </script>
  </body>
</html>
